# Aura ✨ Environment Configuration Template
# Copy this file to .env.local and fill in your legitimate credentials.
# NEVER commit .env.local or real secrets to your repository.

# --- FIREBASE CLIENT CONFIGURATION (Public) ---
# Used by the browser SDK. These are safe to expose to the client.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- RAZORPAY CONFIGURATION ---
# Public Key (Safe for client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Private Secret (MUST REMAIN SERVER-ONLY)
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Optional: Webhook Secret for async verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- GOOGLE GENAI / GEMINI CONFIGURATION ---
# Private API Key (MUST REMAIN SERVER-ONLY)
# prioritized key node for Genkit 1.x
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# --- DEVELOPMENT FLAGS ---
# Set to 'true' only in development to enable the demo-bypass node.
NEXT_PUBLIC_DEMO_MODE=false
