# Aura Firebase Configuration
# These are used by the Client SDK and are safe to expose in the browser, 
# but should be managed via environment variables for security best practices.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI & External Services
# DO NOT expose private keys with NEXT_PUBLIC_ prefix
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Development Flags
NEXT_PUBLIC_DEMO_MODE=true
