{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information for Aura.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "age": { "type": "number" },
        "bio": { "type": "string" },
        "gender": { "type": "string" },
        "orientation": { "type": "string" },
        "interestedIn": { "type": "array", "items": { "type": "string" } },
        "position": { "type": "string", "enum": ["Top", "Bottom", "Versatile", "Not specified"] },
        "room": { "type": "string", "enum": ["Yes", "No"] },
        "verificationStatus": { "type": "string", "enum": ["Verified", "Pending", "Rejected"] },
        "verification": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["not_submitted", "pending", "approved", "rejected"] },
            "imagePath": { "type": "string" },
            "submittedAt": { "type": "string", "format": "date-time" },
            "reviewedAt": { "type": "string", "format": "date-time" },
            "rejectionReason": { "type": "string" }
          }
        },
        "subscriptionStatus": { "type": "string", "enum": ["Active", "Inactive", "Expired"] },
        "plan": { "type": "string", "enum": ["Free", "Elite"], "default": "Free" },
        "subscriptionEndDate": { "type": "string", "format": "date-time" },
        "subscriptionPrice": { "type": "number" },
        "dailyChatCount": { "type": "number", "default": 0 },
        "dailyMediaCount": { "type": "number", "default": 0 },
        "lastResetDate": { "type": "string" },
        "superLikeBalance": { "type": "number", "default": 0 },
        "spotlightExpiry": { "type": "string", "format": "date-time" },
        "incognitoMode": { "type": "boolean", "default": false },
        "isSuspended": { "type": "boolean", "default": false },
        "isAdmin": { "type": "boolean", "default": false },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "lastActive": { "type": "string", "format": "date-time" },
        "isOnline": { "type": "boolean" },
        "photoUrl": { "type": "string" },
        "profilePhotos": { "type": "array", "items": { "type": "string" }, "maxItems": 2 },
        "onboardingCompleted": { "type": "boolean" }
      },
      "required": ["uid", "name", "age", "phoneNumber"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A record of a financial transaction.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "itemType": { "type": "string", "enum": ["Elite", "SuperLike", "Spotlight"] },
        "amount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "razorpayOrderId": { "type": "string" },
        "status": { "type": "string", "enum": ["Success", "Failed", "Pending"] }
      }
    },
    "Report": {
      "title": "Report",
      "description": "A report filed against a user for misconduct.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "targetId": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pending", "Reviewed", "Resolved"] }
      }
    },
    "BlockedUser": {
      "title": "Blocked User",
      "description": "A record of a user blocked by another user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "blockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatRoom": {
      "title": "Chat Room",
      "description": "A private conversation between two users.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "string", "format": "date-time" },
        "typing": { "type": "object" },
        "isSystem": { "type": "boolean" },
        "unreadCount": { "type": "object" },
        "autoDeleteEnabled": { "type": "boolean", "default": false }
      }
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "seen": { "type": "boolean" },
        "isMedia": { "type": "boolean", "default": false },
        "mediaUrl": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "User activity alerts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["verification", "proximity", "message", "welcome", "subscription", "spotlight"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "roomId": { "type": "string" },
        "senderId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile documents."
    },
    "/users/{userId}/blockedUsers/{blockedUserId}": {
      "schema": "#/backend/entities/BlockedUser",
      "description": "List of users blocked by this user."
    },
    "/chatRooms/{roomId}": {
      "schema": "#/backend/entities/ChatRoom",
      "description": "Metadata for active chats."
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": "#/backend/entities/Message",
      "description": "Messages within a specific chat room."
    },
    "/notifications/{notificationId}": {
      "schema": "#/backend/entities/Notification",
      "description": "Real-time user notifications."
    },
    "/purchases/{purchaseId}": {
      "schema": "#/backend/entities/Purchase",
      "description": "Transaction history."
    },
    "/reports/{reportId}": {
      "schema": "#/backend/entities/Report",
      "description": "User misconduct reports."
    }
  }
}