
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information for Aura.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "bio": { "type": "string" },
        "gender": { "type": "string" },
        "orientation": { "type": "string" },
        "verificationStatus": { "type": "string", "enum": ["Verified", "Pending", "Rejected"] },
        "subscriptionStatus": { "type": "string", "enum": ["Active", "Inactive", "Expired"] },
        "subscriptionEndDate": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "lastActive": { "type": "string", "format": "date-time" },
        "isOnline": { "type": "boolean" },
        "photoUrl": { "type": "string" }
      },
      "required": ["uid", "name", "age"]
    },
    "BlockedUser": {
      "title": "Blocked User",
      "description": "A record of a user blocked by another user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "blockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatRoom": {
      "title": "Chat Room",
      "description": "A private conversation between two users.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "string", "format": "date-time" },
        "typing": { "type": "object" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "seen": { "type": "boolean" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "User activity alerts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["verification", "proximity", "message"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profile documents."
    },
    "/users/{userId}/blockedUsers/{blockedUserId}": {
      "schema": "#/entities/BlockedUser",
      "description": "List of users blocked by this user."
    },
    "/chatRooms/{roomId}": {
      "schema": "#/entities/ChatRoom",
      "description": "Metadata for active chats."
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": "#/entities/Message",
      "description": "Messages within a specific chat room."
    },
    "/notifications/{notificationId}": {
      "schema": "#/entities/Notification",
      "description": "Real-time user notifications."
    }
  }
}
