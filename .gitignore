# AURA SECURITY PERIMETER
# Block build artifacts, local secrets, and system logs.

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Output
.next/
out/
build/
dist/

# Firebase Node
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log

# Environment Secrets (CRITICAL)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test

# System Artifacts
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
