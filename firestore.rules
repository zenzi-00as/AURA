rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AURA — Backend Synchronization Protocol v2.5.1
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (
        isAdmin() || (
          resource.data.get('onboardingCompleted', false) == true && 
          resource.data.get('settings', {}).get('incognito', false) == false &&
          resource.data.get('incognitoMode', false) == false
        )
      );

      allow create: if isOwner(userId);
      
      // Hardened update rules for Aura Settings Synchronization
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'isAdmin', 'superLikeBalance', 'isSuperFunder', 
          'spotlightExpiry', 'subscription', 'verificationStatus', 'verification'
        ]) &&
        // Protect Elite Plus features (Incognito)
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['settings']) ||
          request.resource.data.settings.get('incognito', false) == false ||
          resource.data.get('plan', 'free') == 'elite_plus'
        );
        
      allow update, delete: if isAdmin();
      
      match /blockedUsers/{blockedId} {
        allow read: if isOwner(userId) || isOwner(blockedId);
        allow write: if isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
      
      match /presence/{document=**} {
        // High-Fidelity Presence Privacy: Respect showOnlineStatus setting
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          get(/databases/$(database)/documents/users/$(userId)).data.settings.get('showOnlineStatus', true) == true
        );
        allow write: if isOwner(userId);
      }
      
      match /notificationDevices/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /likes/{likeId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUserId;
      allow update, delete: if false; 
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow write: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
        
        allow create: if isAuthenticated() && 
          request.auth.uid == request.resource.data.senderId && 
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;

        allow delete: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
      }
    }

    match /notifications/{notificationId} {
      // Security perimeter for notification records
      allow read, update, delete: if isOwner(resource.data.recipientId);
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId != request.auth.uid;
    }

    match /purchases/{purchaseId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if false; 
    }

    match /superFunds/{fundId} {
      allow read: if isAuthenticated();
      allow create: if false; 
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && 
                   request.resource.data.reporterId == request.auth.uid &&
                   request.resource.data.status == 'Pending';
      allow read, write: if isAdmin();
    }
  }
}