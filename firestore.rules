rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (
        isAdmin() || (
          resource.data.onboardingCompleted == true && 
          resource.data.incognitoMode == false
        )
      );

      allow create: if isOwner(userId);
      
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'isAdmin', 'superLikeBalance', 'usage', 'isSuperFunder', 
          'spotlightExpiry', 'subscription', 'verificationStatus', 'verification'
        ]) &&
        (request.resource.data.incognitoMode == false || resource.data.plan == 'elite_plus');
        
      allow update, delete: if isAdmin();
      
      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      match /notificationDevices/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /likes/{likeId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUserId;
      allow update, delete: if false; 
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow write: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
        
        allow create: if isAuthenticated() && 
          request.auth.uid == request.resource.data.senderId && 
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants &&
          // MANDATORY: 24h Expiration Enforcement
          request.resource.data.expiresAt > request.time + duration.value(23, 'h') &&
          request.resource.data.expiresAt < request.time + duration.value(25, 'h');

        // Allow participants to trigger cleanup of expired messages
        allow delete: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants &&
          (resource.data.expiresAt < request.time || resource.data.timestamp + duration.value(24, 'h') < request.time);
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.type == 'message');
    }

    match /purchases/{purchaseId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if false; 
    }

    match /superFunds/{fundId} {
      allow read: if isAuthenticated();
      allow create: if false; 
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && 
                   request.resource.data.reporterId == request.auth.uid &&
                   request.resource.data.status == 'Pending';
      allow read, write: if isAdmin();
    }
  }
}
